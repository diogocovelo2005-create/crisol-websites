# ─────────────────────────────────────────────────────────────────────
# Google Maps Platform
# ─────────────────────────────────────────────────────────────────────
# A chave tem de ter a "Places API (New)" activa — o servico chamado
# places.googleapis.com. A "Places API" legacy (places-backend.googleapis.com)
# tem nome quase igual na consola e devolve 403 SERVICE_DISABLED em tudo.
#
# Custo: searchNearby/searchText com o mask "places.id" e o SKU
# Essentials (IDs Only) = gratuito e ilimitado. Place Details com
# websiteUri/rating e Enterprise = $20/1000, com 1000 gratis por mes.
# Acrescentar QUALQUER outro campo ao mask de pesquisa salta para Pro
# ($32/1000) sem aviso nenhum na resposta.
GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# Supabase — projeto "crisol leads" (eu-central-1)
# ─────────────────────────────────────────────────────────────────────
# A service role key ignora Row Level Security. Vive so em scripts locais;
# nunca a metas em codigo que corra no browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Ligacao directa ao Postgres. OPCIONAL: so e usada para DDL (criar a tabela do
# nicho e correr o score), porque o PostgREST nao executa create table. Sem ela
# o pipeline imprime o SQL para colares no editor do Supabase e para uma vez,
# em vez de falhar lead a lead.
#   Supabase > Project Settings > Database > Connection string > URI
SUPABASE_DB_URL=

# ─────────────────────────────────────────────────────────────────────
# Nominatim — usado pelo gen-grid.js para resolver a regiao
# ─────────────────────────────────────────────────────────────────────
# A politica de uso do Nominatim exige um User-Agent que te identifique,
# com contacto real, e no maximo 1 pedido por segundo. Um UA generico
# (ou o do curl) leva 403 e nao ha grelha nenhuma.
NOMINATIM_USER_AGENT="lead-scraper/1.0 (o-teu-email@exemplo.pt)"

# ─────────────────────────────────────────────────────────────────────
# Guarda de custo
# ─────────────────────────────────────────────────────────────────────
# Tecto de chamadas Place Details Enterprise por corrida.
#
# DEIXA VAZIO. Vazio significa "o que restar de gratuito este mes" — 1000
# chamadas — e nesse modo o pipeline nao consegue gerar factura nenhuma.
# So preenchendo aqui um numero maior, E passando --aceito-pagar, e que uma
# corrida pode custar dinheiro.
MAX_DETAILS_CALLS=
