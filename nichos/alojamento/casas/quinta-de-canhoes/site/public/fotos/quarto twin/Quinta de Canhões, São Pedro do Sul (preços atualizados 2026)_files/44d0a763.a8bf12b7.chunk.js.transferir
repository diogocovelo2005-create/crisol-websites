s: Boolean = false\n    $shouldGetCompanyLegalName: Boolean = false\n    $shouldGetFacilitiesCount: Boolean = false\n    $shouldGetRelevantForYourTrip: Boolean = false\n    $facilitiesExcludeGroups: [Int!] = []\n    $shouldQueryDescriptionGeneratorSignature: Boolean = false\n    $shouldGetPastUserReservations: Boolean = false\n    $shouldGetUserReservations: Boolean = false\n    $shouldGetPropertyDescriptionGoogleMtVariant: Boolean = false\n    $shouldGetIsInGeniusRateSharingUfiVariant: Boolean = false\n    $isThemeParkBenefitsModernisationOn: Boolean = false\n    $shouldGetUokikSplitOfObligations: Boolean = false\n  ) {\n    hotelPageByPageName(\n      input: {\n        pageNameDetails: $pagenameDetails\n        searchConfig: $searchConfig\n        selectedFilters: $selectedFilters\n      }\n    ) {\n      ... on HotelPageType {\n        propertyDetails(\n          input: { destination: $destination, travelPurpose: $travelPurpose }\n        ) {\n          id\n          facilitiesCount(excludeGroups: $facilitiesExcludeGroups)\n            @include(if: $shouldGetFacilitiesCount)\n          uokikSplitOfObligations\n            @include(if: $shouldGetUokikSplitOfObligations) {\n            bookingObligations {\n              header\n              points\n            }\n            body\n            serviceProviderObligations {\n              header\n              points\n            }\n            title\n          }\n          propertyPageFlags {\n            isPropertyBooked\n            isPrivateBathroomInAllRooms\n          }\n          chainIds\n          brands {\n            chain {\n              id\n            }\n          }\n          ...PropertyBrandInfoFragment @include(if: $isPropertyBrandInfoOn)\n          accommodationType {\n            type\n          }\n          travelProud {\n            isTravelProud\n          }\n          ...PropertyQuestionsAnswersFragment\n            @include(if: $shouldGetQuestionsAndAnswers)\n          walletAndRewardsBalance(input: $walletAndRewardsBalanceInput)\n            @include(if: $isLoggedInUser) {\n            active\n            balance {\n              raw\n              currency\n              prettified\n            }\n          }\n          isTpiExclusiveProperty\n          aiTranslations {\n            name\n          }\n          rooms {\n            id\n            roomPhotos @include(if: $shouldGetRoomPhotosInfo) {\n              id\n              photoUri\n            }\n            translations {\n              name\n            }\n            amenities {\n              groupId\n              id\n              slug\n              instances {\n                id\n                title\n              }\n            }\n          }\n          ...PropertyFacilitiesBlockFragment\n            @include(if: $isPropertyFacilitiesBlockOn)\n          ...PropertyParkingFragment\n            @include(if: $isPropertyParkingfacilityBlockOn)\n          ...PropertyWellnessFragment\n            @include(if: $isPropertyWellnessFacilityBlockOn)\n          ...PropertyHighlightList @include(if: $isPropertyHighlightListOn)\n          ...PropertyMostPopularFacilitiesFields\n            @include(if: $isPropertyMostPopularFacilitiesOn)\n          ...RelevantForYourTripFragment\n            @include(if: $shouldGetRelevantForYourTrip)\n          hotelCurrencyCode\n          ...PropertyHighlightsAccommodationHighlightsFragment\n            @include(if: $shouldGetHighlights)\n          ...FinePrintFragment @include(if: $shouldGetFinePrint)\n          ...RestaurantsFragment\n          ...FoodFacilitiesFragment\n          ...BreakfastFragment\n          preferredValue\n          ...PropertyGalleryFragment\n          ...LegalInfoFragment\n          ...PropertyFinePrintAdditionalFeeWarning_PropertyFields\n          ...HouseRulesFragment\n          ...ThemeParkBenefitsFragment\n            @include(if: $isThemeParkBenefitsModernisationOn)\n          geniusVipPriceMatch(input: $geniusVipPriceMatchInpu