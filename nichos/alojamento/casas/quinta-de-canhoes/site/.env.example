# Formulário de reservas da Quinta de Canhões.
# Copiar para .env.local (em casa) e pôr os mesmos nomes nas variáveis do
# site no Netlify (Site configuration → Environment variables).
# NUNCA comitar os valores reais.

# Por onde saem os emails, por esta ordem:
#   1. Gmail, se GMAIL_UTILIZADOR e GMAIL_PASSE_APP estiverem preenchidos;
#   2. Resend, se houver RESEND_API_KEY;
#   3. senão, pré-visualização em .emails/ (só para testar).

# Gmail por SMTP. A palavra-passe é uma «palavra-passe de aplicação»
# (Conta Google → Segurança → Verificação em dois passos ligada →
# Palavras-passe de aplicações), não a palavra-passe normal.
# O remetente fica «Quinta de Canhões <GMAIL_UTILIZADOR>».
GMAIL_UTILIZADOR=
GMAIL_PASSE_APP=

# Chave da API do Resend (https://resend.com/api-keys). Sem ela, os emails
# não saem: ficam gravados em .emails/ e vêem-se em /dev/emails (em dev).
RESEND_API_KEY=

# Segredo que assina os links dos emails. Pelo menos 32 caracteres ao acaso:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Se mudar, os links já enviados deixam de funcionar.
SEGREDO_RESERVAS=

# Remetente (só para o Resend; com Gmail é a própria conta). Em teste, o do Resend (só entrega ao email da conta do Resend).
# Com o domínio verificado no Resend: "Quinta de Canhões <reservas@quintadecanhoes.com>"
EMAIL_REMETENTE="Quinta de Canhões <onboarding@resend.dev>"

# Para onde vão os emails «da casa» (novo pedido, lembrete do Booking...).
# Produção (só nas variáveis do Netlify): casadecanhoes@gmail.com
# Testes (.env.local): o teu email. Nunca mandar testes à casa.
# Sem valor, o código usa diogocovelo2005@gmail.com, para um esquecimento
# nunca mandar testes à Teresa.
EMAIL_CASA=diogocovelo2005@gmail.com

# Quem é avisado quando um envio falha.
EMAIL_ALERTAS=diogocovelo2005@gmail.com

# Opcional: prefixo nos assuntos, para distinguir testes (ex.: [Teste]).
EMAIL_PREFIXO_ASSUNTO=

# Endereço do site, para os links dos emails (sem barra no fim).
# Em dev: http://localhost:4160. No Netlify, se ficar vazio usa a URL do site.
SITE_URL=http://localhost:4160

# Dados para pagar o sinal. PAGAMENTO_MBWAY por defeito é o 964 506 038.
# Sem PAGAMENTO_TITULAR, a linha do titular não aparece; sem IBAN, o email
# diz que o enviamos à parte.
PAGAMENTO_IBAN=
PAGAMENTO_TITULAR=
PAGAMENTO_MBWAY=
